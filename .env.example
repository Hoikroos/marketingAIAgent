# GROQ (OpenAI-compatible) - AI Content Studio (tuỳ chọn, có thể nhập key trong Cài đặt hệ thống)
# Lấy key tại https://console.groq.com/keys
GROQ_API_KEY="gsk_...thay_bang_key_groq_cua_ban..."
