generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  role          String         @default("Marketing")
  avatar        String?
  phone         String?
  bio           String?
  socialYoutube   String?
  socialTiktok    String?
  socialFacebook  String?
  socialInstagram String?
  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")
  messagesSent        Message[]    @relation("MessageSender")
  messagesReceived    Message[]    @relation("MessageReceiver")
  chatGroups          ChatGroup[]  @relation("ChatGroupCreator")
  groupMemberships    GroupMember[]
  groupMessages       GroupMessage[]
  passwordHash  String?
  resetToken    String?
  resetTokenExpiry DateTime?
  lastActiveAt  DateTime?
  permissions   String         @default("[]")
  jobTitle      String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  contents      Content[]
  leads         Lead[]
  tasks         Task[]
  notifications Notification[]
  workReports   Report[]      @relation("ReportEmployee")
  createdReports Report[]     @relation("ReportCreator")
  adCampaigns   AdCampaign[]
  socialMetrics SocialMetric[]
  trends        Trend[]
  pushSubscriptions PushSubscription[]
}

model Content {
  id          Int       @id @default(autoincrement())
  title       String
  platform    String
  type        String
  tone        String?
  script      String?
  caption     String?
  hashtags    String?
  views       Int       @default(0)
  leads       Int       @default(0)
  score       Int       @default(0)
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  authorId    Int?
  author      User?     @relation(fields: [authorId], references: [id])
}

model Lead {
  id             Int      @id @default(autoincrement())
  name           String
  phone          String?
  source         String
  status         String   @default("Mới")
  purpose        String?
  address        String?
  contacted      String   @default("Chưa liên hệ")
  responseStatus String   @default("Đang chờ khách phản hồi")
  ownerId        Int?
  owner          User?    @relation(fields: [ownerId], references: [id])
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  createdAt      DateTime @default(now())
}

model Task {
  id           Int       @id @default(autoincrement())
  title        String
  assignee     String?
  status       String    @default("Đang thực hiện")
  priority     String    @default("Trung bình")
  deadline     DateTime?
  createdAt    DateTime  @default(now())
  createdById  Int?
  createdBy    User?     @relation(fields: [createdById], references: [id])
}

model Setting {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  value        String
  description  String?
  updatedAt    DateTime @updatedAt
  aiProvider    String   @default("groq")  // "groq", "gemini", "openai"
  aiModel       String   @default("openai/gpt-oss-120b")
  aiApiKey      String?  // Groq API Key
  aiEndpoint    String?
  geminiApiKey  String?  // Google Gemini API Key
  openaiApiKey  String?  // OpenAI API Key
  aiTemperature Float    @default(0.7)
  aiMaxTokens   Int      @default(2000)
  notifyLead    Boolean  @default(true)  // Thông báo khi có lead mới được phân công
  notifyTask    Boolean  @default(true)  // Thông báo khi có task được giao
  notifyReport  Boolean  @default(true)  // Thông báo khi có báo cáo mới
  notifyTrend   Boolean  @default(true)  // Thông báo khi có trend mới
  notifyContent Boolean  @default(true)  // Thông báo khi có nội dung mới
  notifyViral   Boolean  @default(true)  // Thông báo khi có nội dung viral
}

model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  content    String
  read       Boolean  @default(false)
  link       String?
  refId      Int?
  fileName   String?
  filePath   String?
  createdAt  DateTime @default(now())
  @@index([userId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  userName   String?
  module     String   @default("other")
  action     String
  detail     String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  @@index([userId])
}

model SocialMetric {
  id          Int      @id @default(autoincrement())
  platform    String
  channel     String
  followers   Int      @default(0)
  views       Int      @default(0)
  engagement  Int      @default(0)
  videosPosted Int     @default(0) // Số video đã đăng trong tuần
  note        String?
  weekLabel   String   // "YYYY-Wxx" vd "2026-W35"
  ownerId     Int?     // Người tạo số liệu
  owner       User?    @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([platform, channel, weekLabel, ownerId])
}

model SocialChannel {
  id        Int      @id @default(autoincrement())
  platform  String   // "Facebook", "TikTok", "YouTube"
  name      String   // "Pháp Lý", "Review", ...
  createdAt DateTime @default(now())

  @@unique([platform, name])
}

/**
 * File do người dùng tải lên (avatar, logo, chat, báo cáo công việc, thông báo...).
 * Lưu thẳng vào DB (bytea) để BỀN VỮNG qua deploy/restart — ổ đĩa của Render free
 * tier là tạm thời (mỗi deploy mất sạch file trong thư mục uploads/).
 * `path` là đường dẫn tương đối không có tiền tố "uploads/" (vd "avatars/avatar_x.jpg").
 */
model StoredFile {
  path      String   @id
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

model Report {
  id          Int       @id @default(autoincrement())
  title       String
  period      String
  periodLabel String
  employeeId  Int
  employee    User      @relation("ReportEmployee", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status      String    @default("Chưa nộp")
  fileName    String?
  filePath    String?
  submittedAt DateTime?
  createdById Int?
  createdBy   User?     @relation("ReportCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdAt   DateTime  @default(now())
}

model DailyReport {
  id        Int      @id @default(autoincrement())
  userId    Int
  userName  String
  date      String
  tasksDone String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, date])
}

model Friendship {
  id          Int      @id @default(autoincrement())
  requesterId Int
  requester   User     @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId Int
  addressee   User     @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  @@unique([requesterId, addresseeId])
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  sender     User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId Int
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content    String
  imageUrl   String?
  recalled   Boolean  @default(false)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  @@index([senderId])
  @@index([receiverId])
}

model ChatGroup {
  id          Int      @id @default(autoincrement())
  name        String
  createdById Int
  createdBy   User        @relation("ChatGroupCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime    @default(now())
  members     GroupMember[]
  messages    GroupMessage[]
}

model GroupMember {
  id         Int       @id @default(autoincrement())
  groupId    Int
  group      ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?
  @@unique([groupId, userId])
}

model GroupMessage {
  id        Int       @id @default(autoincrement())
  groupId   Int
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User      @relation(fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content   String
  imageUrl  String?
  recalled  Boolean   @default(false)
  createdAt DateTime  @default(now())
  @@index([groupId])
}

model AdCampaign {
  id            Int      @id @default(autoincrement())
  name          String
  platform      String
  objective     String
  status        String   @default("Đang chạy")
  dailyBudget   Float    @default(0)
  totalBudget   Float    @default(0)
  spent         Float    @default(0)
  impressions   Int      @default(0)
  reach         Int      @default(0)
  clicks        Int      @default(0)
  conversions   Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  videoViews    Int      @default(0)
  watchTime     Float    @default(0)
  startDate     DateTime @default(now())
  endDate       DateTime?
  ownerId       Int
  owner         User     @relation(fields: [ownerId], references: [id])
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([ownerId])
  @@index([platform])
  @@index([status])
}

model Trend {
  id             Int      @id @default(autoincrement())
  title          String
  platform       String   @default("TikTok")
  category       String   @default("Chung")
  views          Int      @default(0)
  growth         Float    @default(0)
  score          Int      @default(0)
  recommendation String?
  source         String   @default("ai")
  note           String?
  link           String?
  ownerId        Int?
  owner          User?    @relation(fields: [ownerId], references: [id])
  createdAt      DateTime @default(now())

  @@index([platform])
  @@index([ownerId])
}

model AssistantMessage {
  id            Int      @id @default(autoincrement())
  sessionId     Int?
  userId        Int
  userName      String?
  role          String
  content       String
  attachments   String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId])
}

model AssistantConversation {
  id        Int      @id @default(autoincrement())
  userId    Int
  userName  String?
  title     String   @default("Cuộc trò chuyện mới")
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

/** Sự kiện ngoài trên Lịch nội dung — không gắn với Content (họp, chạy ads, sự kiện công ty...) */
model CalendarEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  userName  String?
  title     String
  note      String?
  eventDate DateTime
  createdAt DateTime @default(now())

  @@index([userId, eventDate])
}
